# Copy to .env and fill in. Never commit .env.
# Host-side tools (migrate, seed, the dashboard's `npm run dev`) use 127.0.0.1.
# The bot and dashboard containers use host `postgres` instead; ticket 03 and 06 set that.

TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_ALLOWED_CHAT_ID=
CLAUDE_CODE_OAUTH_TOKEN=

POSTGRES_USER=owner
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=finance
POSTGRES_PORT=5433

OWNER_DATABASE_URL=postgresql://owner:replace-me@127.0.0.1:5433/finance
AGENT_DATABASE_URL=postgresql://agent:replace-me@127.0.0.1:5433/finance
MIGRATOR_DATABASE_URL=postgresql://migrator:replace-me@127.0.0.1:5433/finance
# Dashboard opens at http://localhost:$DASHBOARD_PORT
DASHBOARD_PORT=4100
DASHBOARD_DATABASE_URL=postgresql://dashboard:replace-me@127.0.0.1:5433/finance

# When true, an additive propose_migration is applied immediately.
# Destructive proposals always stay pending. Default false.
AUTO_APPLY_ADDITIVE=false

# Optional sql-tool limits. Defaults are 15s and 200 rows.
# SQL_STATEMENT_TIMEOUT=15s
# SQL_ROW_CAP=200

# Bank statement PDF passwords. JSON object or comma-separated bank=password pairs.
# The bank name may be written into message.md. The password is not.
# Example shape only: {"hdfc":"","axis":""}
STATEMENT_PASSWORDS=
